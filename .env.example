# Copy to .env (gitignored) and fill in real values. Never commit .env.
# Existing shell environment variables OVERRIDE .env - if an old GEMINI_API_KEY
# is exported in your shell, clear it (`Remove-Item Env:GEMINI_API_KEY` /
# `unset GEMINI_API_KEY`) so the .env value is the one used.
#
# --- live demo credentials (offline tests never read any of these) -----------

# Google Gemini API key. Use your REPLACEMENT key - the key exposed earlier in
# chat must stay revoked. Required for live mode (real proposals) and
# scripts/hermes_smoke.py.
GEMINI_API_KEY=

# Postgres connection string for the durable ledger. Copy it from your Neon
# project's "Connect" panel, INCLUDING the TLS parameters Neon supplies
# (e.g. ?sslmode=require). Ordinary Postgres - NOT a Neon management/API key.
# Run `python scripts/init_neon.py` once after setting this.
DATABASE_URL=

# --- optional overrides (sensible defaults if left blank) --------------------

# Local secret used to sign the SIMULATED webhook fixtures the demo generates.
# This is NOT the Razorpay webhook secret (which is intentionally left blank /
# deferred). If unset, a random per-process secret is generated.
HERMES_DEMO_SIGNING_SECRET=

# Gemini model id (default: gemini-3.7-flash).
HERMES_STRATEGIST_MODEL=

# Demo ledger schema name (default: hermes_demo).
HERMES_DEMO_SCHEMA=

# Razorpay Test Mode is deferred - these are read by nothing yet.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
