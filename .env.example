# Copy to .env (gitignored) and fill in real values. Never commit .env.
# Existing shell environment variables OVERRIDE .env - if an old GEMINI_API_KEY
# is exported in your shell, clear it (`unset GEMINI_API_KEY` /
# `Remove-Item Env:GEMINI_API_KEY`) so the .env value is the one used.
#
# Google Gemini API key - required ONLY for scripts/hermes_smoke.py and any
# real HermesStrategist call. The offline test suite never reads this.
# Use your REPLACEMENT key - the key exposed earlier in chat must stay revoked.
GEMINI_API_KEY=

# Postgres connection string for the planned Neon-backed ledger (slice 4).
# Copy it from your Neon project's "Connect" panel, including the TLS
# parameters Neon supplies (e.g. ?sslmode=require). This is an ordinary
# Postgres URL - NOT a Neon management/API key and NOT a new REST integration.
# Not read yet; persistence is not implemented in this slice.
DATABASE_URL=
